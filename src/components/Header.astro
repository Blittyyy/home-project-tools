---
import Wordmark from './Wordmark.astro';
import { primaryNav } from '../config/navigation';
import SearchBar from './SearchBar.astro';
---

<header>
  <div class="site-utility">
    <div class="container-site">
      <p class="site-utility__text">
        Planning a project?{' '}
        <a href="/calculators">Browse guides, how-tos, and calculators →</a>
      </p>
    </div>
  </div>

  <div class="site-masthead">
    <div class="container-site site-masthead__inner">
      <Wordmark />
      <button
        type="button"
        class="site-menu-btn"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div class="site-nav">
    <div class="container-site site-nav__bar">
      <nav class="site-nav__inner" aria-label="Primary">
        {
          primaryNav.map((item) => (
            <a href={item.href} class="site-nav__link">
              {item.label}
            </a>
          ))
        }
      </nav>
      <button
        type="button"
        class="site-nav__search"
        data-search-toggle
        aria-expanded="false"
        aria-controls="header-search"
        aria-label="Search FixUpWise"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.85">
          <circle cx="11" cy="11" r="6.5" />
          <path d="M16.5 16.5 20 20" />
        </svg>
      </button>
    </div>
  </div>

  <div id="header-search" class="site-search-panel" hidden>
    <div class="container-site py-3">
      <SearchBar autofocus />
    </div>
  </div>

  <div id="mobile-nav" class="site-nav__mobile" hidden>
    <nav class="container-site py-2" aria-label="Mobile">
      {
        primaryNav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const searchToggle = document.querySelector('[data-search-toggle]');
  const navToggle = document.querySelector('[data-nav-toggle]');
  const searchPanel = document.getElementById('header-search');
  const navPanel = document.getElementById('mobile-nav');

  function setOpen(button: Element | null, panel: HTMLElement | null, open: boolean) {
    if (!button || !panel) return;
    button.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
  }

  searchToggle?.addEventListener('click', () => {
    const open = searchToggle.getAttribute('aria-expanded') !== 'true';
    setOpen(searchToggle, searchPanel, open);
    if (open) {
      setOpen(navToggle, navPanel, false);
      const input = searchPanel?.querySelector('input');
      window.setTimeout(() => input?.focus(), 0);
    }
  });

  navToggle?.addEventListener('click', () => {
    const open = navToggle.getAttribute('aria-expanded') !== 'true';
    setOpen(navToggle, navPanel, open);
    if (open) setOpen(searchToggle, searchPanel, false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setOpen(searchToggle, searchPanel, false);
      setOpen(navToggle, navPanel, false);
    }
  });
</script>
