---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  toc.length > 1 && (
    <nav class="mt-6 rounded-xl border border-border bg-sand p-4" aria-label="Table of contents">
      <p class="text-sm font-semibold text-ink">On this page</p>
      <ol class="mt-2 space-y-1.5 text-sm">
        {toc.map((heading) => (
          <li class={heading.depth === 3 ? 'pl-3' : ''}>
            <a href={`#${heading.slug}`} class="text-ink-muted hover:text-brand">
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
