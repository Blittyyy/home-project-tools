---
interface Props {
  initialQuery?: string;
  autofocus?: boolean;
}

const { initialQuery = '', autofocus = false } = Astro.props;
---

<form action="/search" method="get" class="w-full" role="search" data-search-form>
  <label for="site-search-q" class="sr-only">Search articles</label>
  <div class="flex gap-2">
    <input
      id="site-search-q"
      name="q"
      type="search"
      value={initialQuery}
      placeholder="Search articles…"
      autocomplete="off"
      class="w-full rounded-lg border border-border bg-surface-raised px-3 py-2.5 text-ink"
      data-search-input
      autofocus={autofocus ? true : undefined}
    />
    <button type="submit" class="btn-primary shrink-0">Search</button>
  </div>
  <ul
    class="mt-2 hidden rounded-lg border border-border bg-surface-raised shadow-sm"
    data-suggest-list
    hidden
  >
  </ul>
</form>

<script>
  import { suggestArticles, type SearchDocument } from '../utils/search-rank';

  let index: SearchDocument[] | null = null;

  async function loadIndex() {
    if (index) return index;
    const res = await fetch('/search-index.json');
    index = (await res.json()) as SearchDocument[];
    return index;
  }

  const form = document.querySelector('[data-search-form]');
  const input = document.querySelector('[data-search-input]') as HTMLInputElement | null;
  const list = document.querySelector('[data-suggest-list]') as HTMLUListElement | null;

  function hideSuggestions() {
    if (!list) return;
    list.hidden = true;
    list.classList.add('hidden');
    list.innerHTML = '';
  }

  function showSuggestions(docs: ReturnType<typeof suggestArticles>) {
    if (!list) return;
    if (docs.length === 0) {
      hideSuggestions();
      return;
    }
    list.innerHTML = docs
      .map(
        (doc) =>
          `<li><a class="block px-3 py-2 text-sm text-ink hover:bg-sand no-underline" href="${doc.href}">${doc.title}</a></li>`,
      )
      .join('');
    list.hidden = false;
    list.classList.remove('hidden');
  }

  input?.addEventListener('input', async () => {
    const q = input.value.trim();
    if (q.length < 2) {
      hideSuggestions();
      return;
    }
    const docs = suggestArticles(await loadIndex(), q, 5);
    showSuggestions(docs);
  });

  form?.addEventListener('submit', () => hideSuggestions());
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    if (form && !form.contains(event.target)) hideSuggestions();
  });
</script>
