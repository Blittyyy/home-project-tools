---
import type { ArticleEntry } from '../utils/articles';
import { groupBySubcategory } from '../utils/articles';
import ArticleCard from './ArticleCard.astro';
import { categoryHubSchema } from '../utils/schema';
import type { ArticleCategory } from '../config/categories';
import { categoryMeta } from '../config/categories';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  category: ArticleCategory;
  articles: ArticleEntry[];
  /** When hub has ?q=, pass true so the page is noindex. */
  queryNoindex?: boolean;
}

const { category, articles, queryNoindex = false } = Astro.props;
const meta = categoryMeta[category];
const groups = groupBySubcategory(articles);
const emptyHub = articles.length === 0;
const noindex = queryNoindex || emptyHub;
const schema = categoryHubSchema(category, meta.href);
const showGroupLabels = groups.length > 1 || (groups[0]?.articles.length ?? 0) > 1;
---

<BaseLayout
  title={meta.label}
  description={meta.description}
  path={meta.href}
  noindex={noindex}
  schema={[schema]}
>
  <div class="container-site section-space">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: meta.label }]} />
    <header class="mt-6 max-w-3xl">
      <h1 class="section-heading">{meta.label}</h1>
      <p class="section-lede">{meta.description}</p>
    </header>

    {
      emptyHub ? (
        <p class="mt-10 text-ink-muted">
          No published articles in this category yet. Calculators are the primary tools on this site;
          project, material, and how-to guides will appear here as they are published.
        </p>
      ) : (
        <div class="hub-archive mt-8">
          {groups.map((group) => (
            <section
              class="hub-archive__group"
              aria-labelledby={showGroupLabels ? `sub-${group.key}` : undefined}
              aria-label={!showGroupLabels ? group.label : undefined}
            >
              {
                showGroupLabels ? (
                  group.articles.length === 1 ? (
                    <p id={`sub-${group.key}`} class="hub-archive__eyebrow">
                      {group.label}
                    </p>
                  ) : (
                    <h2 id={`sub-${group.key}`} class="hub-archive__heading">
                      {group.label}
                    </h2>
                  )
                ) : null
              }
              <div class="hub-archive__list">
                {group.articles.map((article) => (
                  <ArticleCard article={article} layout="list" />
                ))}
              </div>
            </section>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
