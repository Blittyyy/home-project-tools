---
/**
 * Reusable editorial image shell with fixed aspect ratios.
 * Supports figure captions (used for illustration disclosure).
 */
import OptimizedImage from './OptimizedImage.astro';
import { ILLUSTRATION_DISCLOSURE, type ImageKind } from '../config/editorial';

type Aspect = 'feature' | 'hero' | 'card' | 'thumb';

interface Props {
  src?: string | null;
  alt?: string;
  aspect?: Aspect;
  loading?: 'lazy' | 'eager';
  class?: string;
  caption?: string | null;
  kind?: ImageKind | null;
  /** When false, skip default illustration disclosure. */
  showDisclosure?: boolean;
}

const PLACEHOLDERS: Record<Aspect, { src: string; width: number; height: number; label: string }> = {
  feature: {
    src: '/images/placeholders/feature.svg',
    width: 1200,
    height: 675,
    label: 'Editorial feature image',
  },
  hero: {
    src: '/images/placeholders/hero.svg',
    width: 1200,
    height: 675,
    label: 'Article hero image',
  },
  card: {
    src: '/images/placeholders/card.svg',
    width: 800,
    height: 600,
    label: 'Article card image',
  },
  thumb: {
    src: '/images/placeholders/thumb.svg',
    width: 320,
    height: 200,
    label: 'Sidebar thumbnail',
  },
};

const {
  src,
  alt,
  aspect = 'card',
  loading = 'lazy',
  class: className = '',
  caption,
  kind = null,
  showDisclosure = true,
} = Astro.props;

const preset = PLACEHOLDERS[aspect];
const resolvedSrc = src && src.trim() ? src : preset.src;
/** Allow intentional empty alt for decorative thumbs next to a linked headline. */
const resolvedAlt = alt === undefined || alt === null ? preset.label : alt;
const isPlaceholder = resolvedSrc === preset.src;
const isIllustration = kind === 'illustration';

const resolvedCaption =
  caption?.trim() ||
  (isIllustration && showDisclosure && !isPlaceholder ? ILLUSTRATION_DISCLOSURE : null);
---

<figure
  class:list={[
    'ed-image',
    `ed-image--${aspect}`,
    isIllustration && 'ed-image--illustration',
    resolvedCaption && 'ed-image--captioned',
    className,
  ]}
>
  <OptimizedImage
    src={resolvedSrc}
    alt={resolvedAlt}
    width={preset.width}
    height={preset.height}
    loading={loading}
    class="ed-image__img"
    sizes={
      aspect === 'thumb'
        ? '96px'
        : aspect === 'card'
          ? '(max-width: 640px) 100vw, 280px'
          : '(max-width: 960px) 100vw, 760px'
    }
  />
  {isPlaceholder && <span class="sr-only">{preset.label} placeholder</span>}
  {
    resolvedCaption && aspect !== 'thumb' && (
      <figcaption class="ed-image__caption">{resolvedCaption}</figcaption>
    )
  }
</figure>
