---
import Wordmark from './Wordmark.astro';
import { footerBlurb, footerNav } from '../config/navigation';
import { SITE_NAME } from '../config/site';
---

<footer class="site-footer">
  <div class="container-site site-footer__grid">
    <div>
      <Wordmark variant="footer" />
      <p class="site-footer__blurb">{footerBlurb}</p>
    </div>

    <div>
      <h2 class="site-footer__heading">Explore</h2>
      <ul class="site-footer__list">
        {
          footerNav.explore.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="site-footer__heading">Company</h2>
      <ul class="site-footer__list">
        {
          footerNav.company.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="site-footer__heading">Legal</h2>
      <ul class="site-footer__list">
        {
          footerNav.legal.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="site-footer__legal">
    <div class="container-site">
      © {new Date().getFullYear()} {SITE_NAME}. Planning estimates only — not professional design or code
      approval.
    </div>
  </div>
</footer>
