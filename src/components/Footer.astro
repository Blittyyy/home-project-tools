---
import Wordmark from './Wordmark.astro';
import { footerBlurb, footerNav } from '../config/navigation';
import { SITE_NAME } from '../config/site';
---

<footer class="mt-auto border-t border-border bg-sand">
  <div class="container-site grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2 lg:col-span-1">
      <Wordmark />
      <p class="mt-3 text-sm text-ink-muted">{footerBlurb}</p>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-ink">Explore</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {footerNav.explore.map((item) => (
          <li>
            <a href={item.href} class="text-ink-muted hover:text-brand">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-ink">Company</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {footerNav.company.map((item) => (
          <li>
            <a href={item.href} class="text-ink-muted hover:text-brand">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-ink">Legal</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {footerNav.legal.map((item) => (
          <li>
            <a href={item.href} class="text-ink-muted hover:text-brand">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="container-site py-4 text-xs text-ink-subtle">
      © {new Date().getFullYear()} {SITE_NAME}. Planning estimates only — not professional design or code approval.
    </div>
  </div>
</footer>
