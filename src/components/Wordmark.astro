---
interface Props {
  class?: string;
  variant?: 'default' | 'footer';
}

const { class: className = '', variant = 'default' } = Astro.props;
const wiseLetters = ['W', 'i', 's', 'e'] as const;
---

<a
  href="/"
  class:list={['wordmark', variant === 'footer' && 'wordmark--footer', className]}
  aria-label="FixUpWise home"
>
  <span class="wordmark__fixup">FixUp</span><span class="wordmark__wise" aria-hidden="true"
    >{
      wiseLetters.map((letter, index) => (
        <span class="wordmark__wise-letter" style={`--wise-i: ${index}`}>{letter}</span>
      ))
    }</span
  ><span class="sr-only">Wise</span>
</a>
