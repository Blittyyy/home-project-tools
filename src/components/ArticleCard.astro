---
import type { ArticleEntry } from '../utils/articles';
import { articlePath, categoryMeta, formatArticleDate } from '../utils/articles';

interface Props {
  article: ArticleEntry;
}

const { article } = Astro.props;
const href = articlePath(article);
const category = categoryMeta[article.data.category];
---

<article class="card-surface transition hover:border-brand/30">
  <p class="text-xs font-semibold uppercase tracking-wide text-ink-subtle">{category.label}</p>
  <h3 class="mt-2 font-display text-lg font-semibold text-ink">
    <a href={href} class="text-ink no-underline hover:text-brand hover:underline">{article.data.title}</a>
  </h3>
  <p class="mt-2 text-sm text-ink-muted">{article.data.description}</p>
  <p class="mt-3 text-xs text-ink-subtle">
    <time datetime={article.data.publishedDate.toISOString()}>
      {formatArticleDate(article.data.publishedDate)}
    </time>
  </p>
</article>
