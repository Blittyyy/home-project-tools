---
/**
 * Demo rectangle area calculator — client-side only.
 * Inputs are not stored, cookied, or sent to a server.
 */
---

<div class="card-surface" data-rectangle-area-calculator>
  <form data-calc-form class="space-y-5" novalidate>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="rect-width" class="block text-sm font-semibold text-ink">Width</label>
        <input
          id="rect-width"
          name="width"
          type="number"
          inputmode="decimal"
          min="0"
          step="any"
          value="10"
          required
          class="mt-1.5 w-full rounded-lg border border-border bg-surface px-3 py-2.5"
          data-field="width"
          aria-describedby="rect-width-error"
        />
        <p id="rect-width-error" class="mt-1 hidden text-sm text-red-700" data-error-for="width" role="alert"></p>
      </div>
      <div>
        <label for="rect-height" class="block text-sm font-semibold text-ink">Height</label>
        <input
          id="rect-height"
          name="height"
          type="number"
          inputmode="decimal"
          min="0"
          step="any"
          value="5"
          required
          class="mt-1.5 w-full rounded-lg border border-border bg-surface px-3 py-2.5"
          data-field="height"
          aria-describedby="rect-height-error"
        />
        <p id="rect-height-error" class="mt-1 hidden text-sm text-red-700" data-error-for="height" role="alert"></p>
      </div>
    </div>

    <fieldset>
      <legend class="text-sm font-semibold text-ink">Unit</legend>
      <div class="mt-2 flex flex-wrap gap-3">
        {
          [
            { value: 'in', label: 'Inches' },
            { value: 'ft', label: 'Feet' },
            { value: 'cm', label: 'Centimeters' },
            { value: 'm', label: 'Meters' },
          ].map((unit, index) => (
            <label class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-3 py-2 text-sm">
              <input
                type="radio"
                name="unit"
                value={unit.value}
                checked={index === 0}
                data-field="unit"
              />
              {unit.label}
            </label>
          ))
        }
      </div>
      <p class="mt-1 hidden text-sm text-red-700" data-error-for="unit" role="alert"></p>
    </fieldset>

    <div class="flex flex-wrap gap-3">
      <button type="submit" class="btn-primary">Calculate</button>
      <button type="button" class="btn-secondary" data-reset>Reset</button>
    </div>
  </form>

  <div
    class="mt-6 rounded-xl border border-border bg-sand p-4"
    data-results
    aria-live="polite"
    aria-atomic="true"
  >
    <p class="text-sm text-ink-muted">Enter width and height, then calculate.</p>
  </div>

  <p class="mt-4 text-xs text-ink-subtle">
    Privacy: values stay in your browser. Nothing is saved or sent to a server.
  </p>
</div>

<script>
  import {
    calculateRectangleArea,
    type LengthUnit,
  } from '../utils/rectangle-area';

  const mount = document.querySelector('[data-rectangle-area-calculator]');
  if (mount instanceof HTMLElement) {
    const root = mount;
    const form = root.querySelector('[data-calc-form]') as HTMLFormElement;
    const results = root.querySelector('[data-results]') as HTMLElement;
    const resetBtn = root.querySelector('[data-reset]') as HTMLButtonElement;

    function clearErrors() {
      root.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
        el.textContent = '';
        el.classList.add('hidden');
      });
    }

    function showErrors(errors: { field: string; message: string }[]) {
      clearErrors();
      for (const error of errors) {
        const node = root.querySelector<HTMLElement>(`[data-error-for="${error.field}"]`);
        if (!node) continue;
        node.textContent = error.message;
        node.classList.remove('hidden');
      }
    }

    function readInput() {
      const data = new FormData(form);
      return {
        width: Number(data.get('width')),
        height: Number(data.get('height')),
        unit: String(data.get('unit') || '') as LengthUnit,
      };
    }

    function render() {
      const outcome = calculateRectangleArea(readInput());
      if (!outcome.ok) {
        showErrors(outcome.errors);
        results.innerHTML = `<p class="text-sm text-ink-muted">Fix the highlighted fields to see a result.</p>`;
        return;
      }
      clearErrors();
      const { area, unitLabel, width, height } = outcome.result;
      results.innerHTML = `
        <p class="text-sm font-semibold text-ink">Estimated area</p>
        <p class="mt-1 font-display text-2xl font-semibold text-ink">${area.toLocaleString(undefined, { maximumFractionDigits: 4 })} ${unitLabel}</p>
        <p class="mt-2 text-sm text-ink-muted">${width} × ${height} = ${area.toLocaleString(undefined, { maximumFractionDigits: 4 })}</p>
      `;
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      render();
    });

    resetBtn.addEventListener('click', () => {
      form.reset();
      clearErrors();
      results.innerHTML = `<p class="text-sm text-ink-muted">Enter width and height, then calculate.</p>`;
    });
  }
</script>
