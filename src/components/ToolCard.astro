---
import type { ToolDefinition } from '../data/tools';

interface Props {
  tool: ToolDefinition;
  /** Compact homepage-style module */
  compact?: boolean;
}

const { tool, compact = false } = Astro.props;
const isAvailable = tool.status === 'available';
const shortName = tool.name.replace(/\s+Calculator$/i, '');
---

{
  compact ? (
    isAvailable ? (
      <a href={tool.href} class="pub-calc-module">
        <svg class="pub-calc-module__icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
          <rect x="4" y="4" width="16" height="16" />
          <path d="M8 8h3v3H8zM13 8h3v3h-3zM8 13h3v3H8zM13 13h3v3h-3z" />
        </svg>
        <h3 class="pub-calc-module__name">{tool.name}</h3>
        <p class="pub-calc-module__desc">{tool.description}</p>
        <span class="pub-calc-module__link">Calculate →</span>
      </a>
    ) : (
      <div class="pub-calc-module" aria-disabled="true">
        <h3 class="pub-calc-module__name">{tool.name}</h3>
        <p class="pub-calc-module__desc">{tool.description}</p>
        <span class="pub-calc-module__link" style="color: var(--color-ink-subtle)">Coming soon</span>
      </div>
    )
  ) : (
    <article class="calc-hub-item">
      <h3 class="calc-hub-item__name">{tool.name}</h3>
      <p class="calc-hub-item__desc">{tool.description}</p>
      {isAvailable ? (
        <a href={tool.href} class="calc-hub-item__cta">
          Calculate {shortName.toLowerCase()} →
        </a>
      ) : (
        <p class="calc-hub-item__soon">Coming soon</p>
      )}
    </article>
  )
}
