---
import type { ToolDefinition } from '../data/tools';

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
const isAvailable = tool.status === 'available';
---

<article class="card-surface flex h-full flex-col">
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-display text-lg font-semibold text-ink">{tool.name}</h3>
    {
      !isAvailable && (
        <span class="shrink-0 rounded-md bg-sand px-2 py-1 text-xs font-semibold uppercase tracking-wide text-ink-subtle">
          Coming soon
        </span>
      )
    }
  </div>
  <p class="mt-2 flex-1 text-sm text-ink-muted">{tool.description}</p>
  {
    isAvailable ? (
      <a href={tool.href} class="btn-primary mt-4 self-start">
        Open calculator
      </a>
    ) : (
      <p class="mt-4 text-sm font-medium text-ink-subtle">Not available yet</p>
    )
  }
</article>
