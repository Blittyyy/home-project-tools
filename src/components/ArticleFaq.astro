---
interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="mt-12 border-t border-border pt-8" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="font-display text-xl font-semibold text-ink">
        FAQ
      </h2>
      <div class="mt-4 space-y-4">
        {items.map((item) => (
          <div>
            <h3 class="font-semibold text-ink">{item.question}</h3>
            <p class="mt-1 text-ink-muted">{item.answer}</p>
          </div>
        ))}
      </div>
    </section>
  )
}
