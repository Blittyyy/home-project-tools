---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EditorialImage from '../components/EditorialImage.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ReviewCallout from '../components/ReviewCallout.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import ArticleSources from '../components/ArticleSources.astro';
import ArticleFaq from '../components/ArticleFaq.astro';
import CalculatorCallout from '../components/CalculatorCallout.astro';
import {
  articleBreadcrumbs,
  articlePath,
  categoryMeta,
  formatArticleDate,
  getRelatedArticles,
  getReviewCallout,
  getValidFaq,
  type ArticleEntry,
} from '../utils/articles';
import { articleSchema, breadcrumbSchema } from '../utils/schema';
import { absoluteUrl } from '../utils/seo';
import { getAvailableTools } from '../data/tools';

interface Props {
  article: ArticleEntry;
  headings?: { depth: number; slug: string; text: string }[];
}

const { article, headings = [] } = Astro.props;
const path = articlePath(article);
const crumbs = articleBreadcrumbs(article);
const category = categoryMeta[article.data.category];
const related = await getRelatedArticles(article);
const faq = getValidFaq(article);
const review = getReviewCallout(article.data.reviewLevel);
const noindex = article.data.draft || article.data.noindex;
const ogImage = article.data.featuredImage
  ? absoluteUrl(article.data.featuredImage)
  : undefined;
const popularCalculators = getAvailableTools().slice(0, 5);
const isConcreteArticle = article.data.tags.some((tag) => tag.toLowerCase() === 'concrete');
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  path={path}
  type="article"
  noindex={noindex}
  ogImage={ogImage}
  schema={[articleSchema(article), breadcrumbSchema(crumbs)]}
>
  <article class="container-site article-shell">
    <Breadcrumbs items={crumbs} />

    <div class="article-layout">
      <div class="article-main">
        <header>
          <p class="category-eyebrow">
            <a href={category.href} class="text-brand no-underline hover:underline">{category.label}</a>
            {
              article.data.subcategory && (
                <>
                  <span aria-hidden="true"> · </span>
                  <span class="text-ink-subtle">{article.data.subcategory.replace(/-/g, ' ')}</span>
                </>
              )
            }
          </p>
          <h1 class="article-title">
            {article.data.title}
          </h1>
          {
            article.data.summary && (
              <p class="article-dek">{article.data.summary}</p>
            )
          }
          <div class="article-meta">
            <span>By {article.data.author}</span>
            <span>
              Published{' '}
              <time datetime={article.data.publishedDate.toISOString()}>
                {formatArticleDate(article.data.publishedDate)}
              </time>
            </span>
            {
              article.data.updatedDate && (
                <span>
                  Updated{' '}
                  <time datetime={article.data.updatedDate.toISOString()}>
                    {formatArticleDate(article.data.updatedDate)}
                  </time>
                </span>
              )
            }
          </div>
          {
            article.data.tags.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-2" aria-label="Tags">
                {article.data.tags.map((tag) => (
                  <li class="border border-border bg-sand px-2 py-0.5 text-xs font-medium text-ink-muted">{tag}</li>
                ))}
              </ul>
            )
          }
        </header>

        <EditorialImage
          src={article.data.featuredImage}
          alt={article.data.featuredImageAlt || article.data.title}
          aspect="hero"
          loading="eager"
          class="article-hero"
        />

        {review && <ReviewCallout title={review.title} body={review.body} />}
        {article.data.affiliateDisclosure && <AffiliateDisclosure />}

        <TableOfContents headings={headings} />

        <div class="prose-article mt-6">
          <slot />
        </div>

        {
          isConcreteArticle ? (
            <CalculatorCallout
              eyebrow="Planning a concrete project?"
              title="Concrete Calculator"
              body="Enter your dimensions to estimate cubic yards, bag quantities, and an optional extra-material allowance."
              href="/calculators/concrete-calculator"
              linkLabel="Calculate concrete →"
            />
          ) : (
            <CalculatorCallout
              eyebrow="Need a quantity estimate?"
              title="Project Calculators"
              body="Use a FixUpWise calculator for concrete, gravel, mulch, paint, or tile planning estimates before you shop."
              href="/calculators"
              linkLabel="Browse calculators →"
            />
          )
        }

        <ArticleSources sources={article.data.sources} />
        <ArticleFaq items={faq} />
      </div>

      <aside class="article-sidebar" aria-label="Related resources">
        {
          related.length > 0 && (
            <div class="article-sidebar__block">
              <h2 class="article-sidebar__title">Related guides</h2>
              <ul class="article-sidebar__list">
                {related.map((item) => (
                  <li>
                    <a href={articlePath(item)}>{item.data.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="article-sidebar__block">
          <h2 class="article-sidebar__title">Popular calculators</h2>
          <ul class="article-sidebar__list">
            {
              popularCalculators.map((tool) => (
                <li>
                  <a href={tool.href}>{tool.name}</a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="article-sidebar__block">
          <h2 class="article-sidebar__title">Browse</h2>
          <ul class="article-sidebar__list">
            <li><a href="/projects">Projects</a></li>
            <li><a href="/materials">Materials</a></li>
            <li><a href="/guides">Guides</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
