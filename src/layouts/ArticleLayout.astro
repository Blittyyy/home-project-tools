---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EditorialImage from '../components/EditorialImage.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ReviewCallout from '../components/ReviewCallout.astro';
import PlanningNote from '../components/PlanningNote.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import ArticleSources from '../components/ArticleSources.astro';
import ArticleFaq from '../components/ArticleFaq.astro';
import CalculatorCallout from '../components/CalculatorCallout.astro';
import {
  articleBreadcrumbs,
  articlePath,
  categoryMeta,
  formatArticleDate,
  getRelatedArticles,
  getReviewCallout,
  getValidFaq,
  type ArticleEntry,
} from '../utils/articles';
import { EDITORIAL_FORMAT_LABELS, METHODOLOGY_PATH } from '../config/editorial';
import { SHOW_PUBLIC_ARTICLE_DATES } from '../config/site';
import { articleSchema, breadcrumbSchema } from '../utils/schema';
import { absoluteUrl } from '../utils/seo';
import { getAvailableTools } from '../data/tools';

interface Props {
  article: ArticleEntry;
  headings?: { depth: number; slug: string; text: string }[];
}

const { article, headings = [] } = Astro.props;
const path = articlePath(article);
const crumbs = articleBreadcrumbs(article);
const category = categoryMeta[article.data.category];
const related = await getRelatedArticles(article);
const faq = getValidFaq(article);
const planningNote = article.data.planningNote;
const review = planningNote ? null : getReviewCallout(article.data.reviewLevel);
const formatLabel = article.data.editorialFormat
  ? EDITORIAL_FORMAT_LABELS[article.data.editorialFormat]
  : null;
const noindex = article.data.draft || article.data.noindex;
const ogImage = article.data.featuredImage
  ? absoluteUrl(article.data.featuredImage)
  : undefined;
const popularCalculators = getAvailableTools().slice(0, 5);
const isConcreteArticle = article.data.tags.some((tag) => tag.toLowerCase() === 'concrete');
const isPaintArticle = article.data.tags.some((tag) => tag.toLowerCase() === 'paint');
const isMulchArticle = article.data.tags.some((tag) => tag.toLowerCase() === 'mulch');
const isTileArticle = article.data.tags.some((tag) => tag.toLowerCase() === 'tile');
const showDates = SHOW_PUBLIC_ARTICLE_DATES;
const hasInlinePhoto = Boolean(article.data.photo?.trim());
const showCalculatorCallout = !article.data.suppressCalculatorCallout;
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  path={path}
  type="article"
  noindex={noindex}
  ogImage={ogImage}
  schema={[articleSchema(article), breadcrumbSchema(crumbs)]}
>
  <article class="container-site article-shell">
    <Breadcrumbs items={crumbs} />

    <header class="article-header">
      <p class="category-eyebrow">
        <a href={category.href} class="text-brand no-underline hover:underline">{category.label}</a>
        {
          formatLabel && (
            <>
              <span aria-hidden="true"> · </span>
              <span class="text-ink-subtle">{formatLabel}</span>
            </>
          )
        }
        {
          !formatLabel && article.data.subcategory && (
            <>
              <span aria-hidden="true"> · </span>
              <span class="text-ink-subtle">{article.data.subcategory.replace(/-/g, ' ')}</span>
            </>
          )
        }
      </p>
      <h1 class="article-title">
        {article.data.title}
      </h1>
      {
        article.data.summary && (
          <p class="article-dek">{article.data.summary}</p>
        )
      }
      <div class="article-meta">
        <span>
          By{' '}
          <a href={METHODOLOGY_PATH} class="article-meta__author">
            {article.data.author}
          </a>
        </span>
        {
          showDates && (
            <span>
              Published{' '}
              <time datetime={article.data.publishedDate.toISOString()}>
                {formatArticleDate(article.data.publishedDate)}
              </time>
            </span>
          )
        }
        {
          showDates && article.data.updatedDate && (
            <span>
              Updated{' '}
              <time datetime={article.data.updatedDate.toISOString()}>
                {formatArticleDate(article.data.updatedDate)}
              </time>
            </span>
          )
        }
      </div>
      {
        article.data.tags.length > 0 && (
          <ul class="article-tags" aria-label="Tags">
            {article.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="article-layout">
      <div class="article-main">
        <EditorialImage
          src={article.data.featuredImage}
          alt={article.data.featuredImageAlt || article.data.title}
          aspect="hero"
          loading="eager"
          class="article-hero"
          kind={article.data.featuredImageKind}
          caption={article.data.featuredImageCaption}
        />

        {
          planningNote && (
            <PlanningNote
              title={planningNote.title}
              body={planningNote.body}
              bullets={planningNote.bullets}
            />
          )
        }
        {review && <ReviewCallout title={review.title} body={review.body} />}
        {article.data.affiliateDisclosure && <AffiliateDisclosure />}

        <TableOfContents headings={headings} />

        <div class="prose-article mt-6">
          <slot />
        </div>

        {
          hasInlinePhoto && (
            <EditorialImage
              src={article.data.photo}
              alt={article.data.photoAlt || ''}
              aspect="hero"
              kind="photo"
              caption={[article.data.photoCaption, article.data.photoCredit]
                .filter(Boolean)
                .join(' — ')}
              showDisclosure={false}
              class="article-inline-photo"
            />
          )
        }

        {
          showCalculatorCallout &&
            (isTileArticle ? (
              <CalculatorCallout
                eyebrow="Planning a tile project?"
                title="Tile Calculator"
                body="Enter your project area, tile size, layout, and optional box information to estimate tiles and boxes."
                href="/calculators/tile-calculator"
                linkLabel="Calculate tile →"
              />
            ) : isMulchArticle ? (
              <CalculatorCallout
                eyebrow="Planning a mulch project?"
                title="Mulch Calculator"
                body="Enter your area and mulch depth to estimate cubic yards and bag quantities."
                href="/calculators/mulch-calculator"
                linkLabel="Calculate mulch →"
              />
            ) : isPaintArticle ? (
              <CalculatorCallout
                eyebrow="Planning a paint project?"
                title="Paint Calculator"
                body="Enter your room dimensions, coats, coverage rate, and optional doors/windows to estimate how many gallons you need."
                href="/calculators/paint-calculator"
                linkLabel="Calculate paint →"
              />
            ) : isConcreteArticle ? (
              <CalculatorCallout
                eyebrow="Planning a concrete project?"
                title="Concrete Calculator"
                body="Enter your dimensions to estimate cubic yards, bag quantities, and an optional extra-material allowance."
                href="/calculators/concrete-calculator"
                linkLabel="Calculate concrete →"
              />
            ) : (
              <CalculatorCallout
                eyebrow="Need a quantity estimate?"
                title="Project Calculators"
                body="Use a FixUpWise calculator for concrete, gravel, mulch, paint, or tile planning estimates before you shop."
                href="/calculators"
                linkLabel="Browse calculators →"
              />
            ))
        }

        <ArticleSources sources={article.data.sources} />
        <ArticleFaq items={faq} />
      </div>

      <aside class="article-sidebar" aria-label="Related resources">
        {
          related.length > 0 && (
            <div class="article-sidebar__block">
              <h2 class="article-sidebar__title">Related guides</h2>
              <ul class="article-sidebar__list">
                {related.map((item) => (
                  <li>
                    <a href={articlePath(item)}>{item.data.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="article-sidebar__block">
          <h2 class="article-sidebar__title">Popular calculators</h2>
          <ul class="article-sidebar__list">
            {
              popularCalculators.map((tool) => (
                <li>
                  <a href={tool.href}>{tool.name}</a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="article-sidebar__block">
          <h2 class="article-sidebar__title">Browse</h2>
          <ul class="article-sidebar__list">
            <li><a href="/projects">Projects</a></li>
            <li><a href="/materials">Materials</a></li>
            <li><a href="/guides">Guides</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
