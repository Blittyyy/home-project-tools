---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE_NAME } from '../config/site';
---

<PageLayout
  title="Disclaimer"
  description={`Content disclaimer for ${SITE_NAME}. Review and complete before launch.`}
  path="/disclaimer"
>
  <p>
    Articles and tools on this demo site are <strong>sample starter content</strong> meant to prove the architecture.
    They are not professional advice for any regulated niche.
  </p>
  <p>
    When you launch a real site, rewrite this disclaimer for your domain (medical, financial, legal, DIY safety, etc.)
    and align it with your review/risk taxonomy in <code>src/config/review.ts</code>.
  </p>
  <p class="rounded-xl border border-warning-border bg-warning-bg p-4 text-sm text-warning">
    Requires review: do not invent affiliate status, certifications, or jurisdiction-specific warnings here.
  </p>
</PageLayout>
