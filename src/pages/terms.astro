---
import PageLayout from '../layouts/PageLayout.astro';
import { CONTACT_EMAIL, SITE_NAME } from '../config/site';
---

<PageLayout
  title="Terms"
  description={`Terms of use for ${SITE_NAME}. Review and complete before launch.`}
  path="/terms"
>
  <p>
    These terms are a <strong>generic placeholder</strong> for the starter repository. They are not a substitute for counsel-reviewed terms.
  </p>
  <p>
    Content on this demo site is provided for illustration of the publishing architecture only.
  </p>
  <p>
    Contact placeholder: <strong>{CONTACT_EMAIL}</strong>
  </p>
  <p class="rounded-xl border border-warning-border bg-warning-bg p-4 text-sm text-warning">
    Requires review: do not invent governing law, legal entity, liability caps, or dispute forums without counsel.
  </p>
</PageLayout>
