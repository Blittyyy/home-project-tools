---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="The page you requested could not be found."
  path="/404"
  noindex={true}
  robotsFollow={false}
>
  <div class="container-site section-space text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-ink-subtle">404</p>
    <h1 class="mt-3 section-heading justify-self-center">Page not found</h1>
    <p class="mx-auto mt-3 max-w-lg text-ink-muted">
      That URL is not part of this site. Try the homepage, a category hub, or search.
    </p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="btn-primary">Home</a>
      <a href="/search" class="btn-secondary">Search</a>
    </div>
  </div>
</BaseLayout>
