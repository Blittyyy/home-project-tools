---
import PageLayout from '../layouts/PageLayout.astro';
import { CONTACT_EMAIL, SITE_NAME, SITE_URL } from '../config/site';
---

<PageLayout
  title="Privacy"
  description={`Privacy information for ${SITE_NAME}. Review and complete before launch.`}
  path="/privacy"
>
  <p>
    This privacy page is a <strong>shell awaiting human review</strong>. It is not legal advice.
  </p>
  <h2 class="mt-8 font-display text-xl font-semibold text-ink">What this site collects</h2>
  <ul>
    <li>Calculator inputs stay in your browser and are not sent to a server by this application.</li>
    <li>Internal search queries are not stored by this application.</li>
    <li>
      If Vercel Analytics remains enabled, usage metrics may be collected as described by Vercel. Document
      the final analytics setup here before launch.
    </li>
  </ul>
  <h2 class="mt-8 font-display text-xl font-semibold text-ink">Contact</h2>
  <p>
    Privacy contact placeholder: <strong>{CONTACT_EMAIL}</strong>
  </p>
  <p class="rounded-xl border border-warning-border bg-warning-bg p-4 text-sm text-warning">
    Requires review: jurisdiction, legal entity, data retention, cookies, and subprocessors are intentionally
    not invented. Site URL currently set to {SITE_URL}.
  </p>
</PageLayout>
