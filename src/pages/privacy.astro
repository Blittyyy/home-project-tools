---
import PageLayout from '../layouts/PageLayout.astro';
import { CONTACT_EMAIL, CONTACT_EMAIL_READY, SITE_NAME } from '../config/site';
---

<PageLayout
  title="Privacy"
  description={`Privacy information for ${SITE_NAME}.`}
  path="/privacy"
>
  <p>
    This page describes how {SITE_NAME} handles information in the current static site. It is not legal
    advice. Jurisdiction-specific notices and a named legal entity will be added only when they are real.
  </p>

  <h2 class="mt-8 font-display text-xl font-semibold text-ink">What this site collects</h2>
  <ul>
    <li>Calculator inputs stay in your browser and are not sent to a server by this application.</li>
    <li>Internal search queries are not stored by this application.</li>
    <li>
      If Vercel Analytics (or similar hosting analytics) is enabled in production, usage metrics may be
      collected as described by that provider. Document the final analytics setup here when production
      hosting is confirmed.
    </li>
  </ul>

  <h2 class="mt-8 font-display text-xl font-semibold text-ink">Contact</h2>
  {
    CONTACT_EMAIL_READY ? (
      <p>
        Privacy questions: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </p>
    ) : (
      <p>
        A privacy contact email will appear here once a monitored inbox is configured. See
        <a href="/contact">Contact</a>.
      </p>
    )
  }
</PageLayout>
