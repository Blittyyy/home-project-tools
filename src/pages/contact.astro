---
import PageLayout from '../layouts/PageLayout.astro';
import { CONTACT_EMAIL, CONTACT_EMAIL_READY, SITE_NAME } from '../config/site';
---

<PageLayout
  title="Contact"
  description={`Contact ${SITE_NAME} about guides, calculators, or site feedback.`}
  path="/contact"
>
  {
    CONTACT_EMAIL_READY ? (
      <>
        <p>For questions about this site, email:</p>
        <p>
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </p>
      </>
    ) : (
      <>
        <p>
          A public contact email for {SITE_NAME} has not been published yet. When a monitored inbox is
          configured, it will appear on this page.
        </p>
        <p>
          No fabricated address, phone number, or business location is listed here.
        </p>
      </>
    )
  }
</PageLayout>
