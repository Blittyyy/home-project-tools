---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {
  CALCULATORS_HUB,
  TOOL_GROUPS,
  TOOL_GROUP_LABELS,
  tools,
  hasAvailableTools,
  type ToolGroup,
} from '../../data/tools';
import { SITE_NAME, SITE_URL } from '../../config/site';
import { absoluteUrl } from '../../utils/seo';

const noindex = !hasAvailableTools();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Project Calculators',
  description: CALCULATORS_HUB.description,
  url: absoluteUrl('/calculators'),
  isPartOf: {
    '@type': 'WebSite',
    name: SITE_NAME,
    url: SITE_URL,
  },
};

const grouped = TOOL_GROUPS.map((group: ToolGroup) => ({
  group,
  label: TOOL_GROUP_LABELS[group],
  tools: tools.filter((tool) => tool.group === group),
})).filter((section) => section.tools.length > 0);
---

<BaseLayout
  title="Project Calculators"
  description={CALCULATORS_HUB.description}
  path="/calculators"
  noindex={noindex}
  schema={[schema]}
>
  <div class="container-site section-space">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Calculators' }]} />
    <header class="mt-5 max-w-3xl">
      <p class="category-eyebrow">Resources</p>
      <h1 class="section-heading mt-2">Project Calculators</h1>
      <p class="section-lede">
        Practical planning tools from FixUpWise. Estimate material quantities, waste allowance, and package counts
        before you buy — then confirm product packaging and installation requirements for your project.
      </p>
      {
        noindex && (
          <p class="mt-4 text-sm text-ink-muted">
            Calculators listed below are coming soon. No live tools are available yet.
          </p>
        )
      }
    </header>

    <div class="mt-4">
      {
        grouped.map((section) => (
          <section class="calc-hub-group" aria-labelledby={`group-${section.group}`}>
            <h2 id={`group-${section.group}`} class="calc-hub-group__title">
              {section.label}
            </h2>
            <div class="calc-hub-list">
              {section.tools.map((tool) => (
                <ToolCard tool={tool} />
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
