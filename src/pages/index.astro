---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { SITE_DESCRIPTION, SITE_NAME, SITE_TAGLINE } from '../config/site';
import { CATEGORIES } from '../config/categories';
import { organizationSchema, websiteSchema } from '../utils/schema';
import { getAvailableTools, tools, hasAvailableTools } from '../data/tools';

const availableTools = getAvailableTools();
const upcomingTools = tools.filter((tool) => tool.status === 'coming-soon');
const categoryList = Object.values(CATEGORIES);
const liveTools = hasAvailableTools();
---

<BaseLayout
  title={SITE_NAME}
  description={SITE_DESCRIPTION}
  path="/"
  schema={[organizationSchema(), websiteSchema()]}
>
  <section class="border-b border-border bg-gradient-to-b from-brand-soft/70 via-surface to-surface">
    <div class="container-site section-space">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand">{SITE_NAME}</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        {SITE_TAGLINE}
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-muted">
        Material and project planning utilities for homeowners and DIYers. Calculate quantities, waste
        allowance, dimensions, unit conversions, and bags, boxes, or packages to buy.
      </p>
      <p class="mt-3 max-w-2xl text-base text-ink-subtle">
        These are planning estimates only — not structural engineering, building-code approval, electrical
        or plumbing design, architectural plans, or contractor bids.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/calculators" class="btn-primary">Browse calculators</a>
        <a href="/guides" class="btn-secondary">Guides</a>
      </div>
    </div>
  </section>

  <section class="container-site section-space">
    <h2 class="section-heading">Calculators</h2>
    {
      liveTools ? (
        <>
          <p class="section-lede">
            Start with a calculator to estimate material quantities before you shop.
          </p>
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {availableTools.map((tool) => (
              <ToolCard tool={tool} />
            ))}
          </div>
        </>
      ) : (
        <>
          <p class="section-lede">
            Live calculators are not available yet. The first tools in progress cover concrete, gravel,
            mulch, paint, and tile planning estimates.
          </p>
          <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {upcomingTools.map((tool) => (
              <ToolCard tool={tool} />
            ))}
          </div>
        </>
      )
    }
  </section>

  <section class="border-y border-border bg-sand/60">
    <div class="container-site section-space">
      <h2 class="section-heading">What you will be able to calculate</h2>
      <p class="section-lede">
        Each tool focuses on clear planning math with visible assumptions — not professional pricing or
        code compliance.
      </p>
      <ul class="mt-8 grid gap-3 text-ink-muted sm:grid-cols-2">
        <li>Material quantities from project dimensions</li>
        <li>Waste allowance you can see and adjust</li>
        <li>Unit conversions for common DIY measurements</li>
        <li>Bags, boxes, and package counts where they apply</li>
        <li>Shopping-list style totals for purchasing</li>
        <li>Estimated material cost later, when sourced prices are available</li>
      </ul>
    </div>
  </section>

  <section class="container-site section-space">
    <h2 class="section-heading">Guides coming later</h2>
    <p class="section-lede">
      Supporting articles for project planning, materials, and measurement will publish after the first
      calculators ship. Category hubs stay unindexed until they have real content.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        categoryList.map((category) => (
          <a href={category.href} class="card-surface block no-underline transition hover:border-brand/40">
            <h3 class="font-display text-lg font-semibold text-ink">{category.label}</h3>
            <p class="mt-2 text-sm text-ink-muted">{category.description}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
