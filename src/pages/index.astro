---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ToolCard from '../components/ToolCard.astro';
import { SITE_DESCRIPTION, SITE_NAME, SITE_TAGLINE } from '../config/site';
import { CATEGORIES } from '../config/categories';
import { getFeaturedArticles } from '../utils/articles';
import { organizationSchema, websiteSchema } from '../utils/schema';
import { getAvailableTools, tools } from '../data/tools';

const featured = await getFeaturedArticles(3);
const availableTools = getAvailableTools();
const categoryList = Object.values(CATEGORIES);
const primaryCategory = categoryList[0];
---

<BaseLayout
  title={SITE_NAME}
  description={SITE_DESCRIPTION}
  path="/"
  schema={[organizationSchema(), websiteSchema()]}
>
  <section class="border-b border-border bg-gradient-to-b from-brand-soft/70 via-surface to-surface">
    <div class="container-site section-space">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand">{SITE_NAME}</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        {SITE_NAME}
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-muted">{SITE_TAGLINE}</p>
      <p class="mt-3 max-w-2xl text-base text-ink-subtle">
        Demo homepage for the reusable SEO site starter. Replace branding, categories, and seed content for your niche.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        {
          primaryCategory && (
            <a href={primaryCategory.href} class="btn-primary">
              Browse {primaryCategory.label.toLowerCase()}
            </a>
          )
        }
        <a href="/calculators" class="btn-secondary">Try a calculator</a>
      </div>
    </div>
  </section>

  <section class="container-site section-space">
    <h2 class="section-heading">Categories</h2>
    <p class="section-lede">Neutral demo hubs. Redefine these in <code>src/config/categories.ts</code>.</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        categoryList.map((category) => (
          <a href={category.href} class="card-surface block no-underline transition hover:border-brand/40">
            <h3 class="font-display text-lg font-semibold text-ink">{category.label}</h3>
            <p class="mt-2 text-sm text-ink-muted">{category.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="border-y border-border bg-sand/60">
    <div class="container-site section-space">
      <h2 class="section-heading">Sample articles</h2>
      <p class="section-lede">
        Three published demo articles prove routing, hubs, search, and sitemap. Remove them before real launch.
      </p>
      {
        featured.length > 0 ? (
          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            {featured.map((article) => <ArticleCard article={article} />)}
          </div>
        ) : (
          <p class="mt-8 text-ink-muted">No published sample articles yet.</p>
        )
      }
    </div>
  </section>

  <section class="container-site section-space">
    <h2 class="section-heading">Tools</h2>
    <p class="section-lede">
      {availableTools.length > 0
        ? 'One demo calculator ships with the starter architecture.'
        : 'No tools available yet.'}
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {tools.slice(0, 2).map((tool) => <ToolCard tool={tool} />)}
    </div>
  </section>
</BaseLayout>
