---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import EditorialImage from '../components/EditorialImage.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SHOW_PUBLIC_ARTICLE_DATES, SITE_DESCRIPTION, SITE_NAME } from '../config/site';
import { METHODOLOGY_PATH } from '../config/editorial';
import { organizationSchema, websiteSchema } from '../utils/schema';
import { getAvailableTools } from '../data/tools';
import {
  articlePath,
  categoryMeta,
  formatArticleDate,
  getFeaturedArticles,
  getIndexableArticles,
} from '../utils/articles';

const availableTools = getAvailableTools();
const featuredPool = await getFeaturedArticles(1);
const allArticles = await getIndexableArticles();
const featured = featuredPool[0] ?? allArticles[0];

function articleTopic(article: (typeof allArticles)[number]): string {
  const tags = article.data.tags.map((tag) => tag.toLowerCase());
  if (tags.includes('tile')) return 'tile';
  if (tags.includes('mulch')) return 'mulch';
  if (tags.includes('paint')) return 'paint';
  if (tags.includes('concrete')) return 'concrete';
  return article.data.subcategory?.trim() || article.data.category;
}

/** Prefer topic mix (concrete + paint + mulch + tile) instead of date-only latest strip. */
function pickMixedArticles(
  articles: typeof allArticles,
  excludeId: string | undefined,
  limit: number,
) {
  const pool = articles.filter((article) => article.id !== excludeId);
  const picked: typeof allArticles = [];
  const used = new Set<string>();

  for (const topic of ['concrete', 'paint', 'mulch', 'tile'] as const) {
    const hit = pool.find((article) => articleTopic(article) === topic && !used.has(article.id));
    if (hit) {
      picked.push(hit);
      used.add(hit.id);
    }
  }

  for (const category of ['projects', 'materials', 'guides'] as const) {
    if (picked.length >= limit) break;
    const hit = pool.find(
      (article) => article.data.category === category && !used.has(article.id),
    );
    if (hit) {
      picked.push(hit);
      used.add(hit.id);
    }
  }

  for (const article of pool) {
    if (picked.length >= limit) break;
    if (!used.has(article.id)) {
      picked.push(article);
      used.add(article.id);
    }
  }

  return picked.slice(0, limit);
}

const sideStories = pickMixedArticles(allArticles, featured?.id, 4);
const latestArticles = pickMixedArticles(allArticles, featured?.id, 4);
---

<BaseLayout
  title={SITE_NAME}
  description={SITE_DESCRIPTION}
  path="/"
  schema={[organizationSchema(), websiteSchema()]}
>
  <div class="container-site">
    <section class="pub-featured" aria-labelledby="featured-heading">
      {
        featured ? (
          <>
            <div class="pub-featured__main">
              <header class="pub-featured__copy">
                <p class="category-eyebrow">{categoryMeta[featured.data.category].label}</p>
                <h1 id="featured-heading" class="pub-featured__headline">
                  <a href={articlePath(featured)} class="text-ink no-underline hover:underline hover:text-brand">
                    {featured.data.title}
                  </a>
                </h1>
                <p class="pub-featured__dek">
                  {featured.data.summary ?? featured.data.description}
                </p>
                <p class="pub-featured__meta">
                  <a href={METHODOLOGY_PATH}>{featured.data.author}</a>
                  {
                    SHOW_PUBLIC_ARTICLE_DATES && (
                      <>
                        <span aria-hidden="true"> · </span>
                        <time datetime={featured.data.publishedDate.toISOString()}>
                          {formatArticleDate(featured.data.publishedDate)}
                        </time>
                      </>
                    )
                  }
                  <span aria-hidden="true"> · </span>
                  <a href={articlePath(featured)}>Read the guide →</a>
                </p>
              </header>
              <a
                href={articlePath(featured)}
                class="pub-featured__media-link"
                aria-label={`Read: ${featured.data.title}`}
              >
                <EditorialImage
                  src={featured.data.featuredImage}
                  alt=""
                  aspect="feature"
                  loading="eager"
                  class="pub-featured__media"
                  kind={featured.data.featuredImageKind}
                  showDisclosure={false}
                />
              </a>
            </div>

            <aside class="pub-side-list" aria-labelledby="side-stories-heading">
              <h2 id="side-stories-heading" class="pub-side-list__title">Latest guides</h2>
              {sideStories.map((item) => (
                <a class="pub-side-item" href={articlePath(item)}>
                  <EditorialImage
                    src={item.data.featuredImage}
                    alt={item.data.featuredImageAlt || item.data.title}
                    kind={item.data.featuredImageKind}
                    showDisclosure={false}
                    aspect="thumb"
                    class="pub-side-item__thumb"
                  />
                  <span class="pub-side-item__body">
                    <p class="pub-side-item__title">{item.data.title}</p>
                    <p class="pub-side-item__meta">{categoryMeta[item.data.category].label}</p>
                  </span>
                </a>
              ))}
            </aside>
          </>
        ) : (
          <div class="pub-featured__main">
            <header class="pub-featured__copy">
              <p class="category-eyebrow">Home projects</p>
              <h1 id="featured-heading" class="pub-featured__headline">
                Plan the materials before you start the project
              </h1>
              <p class="pub-featured__dek">
                Practical home-improvement guidance with calculators for concrete, gravel, mulch, paint, and tile.
              </p>
            </header>
          </div>
        )
      }
    </section>

    {
      latestArticles.length > 0 && (
        <section class="pub-section" aria-labelledby="latest-heading">
          <div class="pub-section__header">
            <h2 id="latest-heading" class="pub-section__title">Latest articles</h2>
            <p class="pub-section__desc">Practical guides across concrete, paint, landscaping, tile, and related estimating topics.</p>
          </div>
          <div class="pub-article-grid">
            {latestArticles.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        </section>
      )
    }

    <section class="pub-section" aria-labelledby="calculators-heading">
      <div class="pub-section__header">
        <h2 id="calculators-heading" class="pub-section__title">Calculators</h2>
        <p class="pub-section__desc">Quick, practical tools to help plan your next project.</p>
      </div>
      <div class="pub-calc-grid">
        {availableTools.map((tool) => <ToolCard tool={tool} compact />)}
      </div>
    </section>

    <nav class="pub-section-links" aria-label="Publication sections">
      <a href="/projects">Projects</a>
      <a href="/materials">Materials</a>
      <a href="/guides">Guides</a>
      <a href="/about">About</a>
    </nav>
  </div>
</BaseLayout>
